# Ejecución local con npm run dev
VITE_USE_EMULATORS=true

# Obligatorias para usar un proyecto Firebase real.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Bucket de Firebase Storage autorizado. Vacío deja inactiva la carga en producción.
VITE_FIREBASE_STORAGE_BUCKET=
# Límite de cliente en MiB. Valores enteros de 1 a 128, predeterminado 64. Firestore aplica además maxBytes.
VITE_HANDOUT_MAX_MIB=64
