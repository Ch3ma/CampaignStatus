rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cell-handouts/{cellId}/{handoutId}/{revision}/content {
      function role() {
        return firestore.get(/databases/(default)/documents/cells/$(cellId)/members/$(request.auth.uid)).data.role;
      }
      function handout() {
        return firestore.get(/databases/(default)/documents/cells/$(cellId)/handouts/$(handoutId)).data;
      }
      function validAddress() {
        return handoutId.matches('^[a-zA-Z0-9_-]{1,128}$') && revision.matches('^[a-zA-Z0-9]{20}$');
      }
      function assignedRevision(field) {
        return handout().cloud[field] == revision;
      }
      allow get: if request.auth != null && validAddress()
        && (role() == 'handler' || (role() == 'agent' && handout().status == 'published'
          && assignedRevision('active')));
      allow create: if request.auth != null && validAddress() && role() == 'handler'
        && resource == null && assignedRevision('pending') && handout().status != 'published'
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.contentDisposition == 'attachment'
        && request.resource.size > 28 && request.resource.size <= 33554460
        && request.resource.metadata.keys().hasOnly([]);
      allow delete: if request.auth != null && validAddress() && role() == 'handler' && assignedRevision('cleanup');
    }
  }
}
