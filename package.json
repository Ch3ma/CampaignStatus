{
  "name": "black-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "emulators": "firebase emulators:start --project demo-black-archive --only auth,firestore",
    "seed": "node scripts/seed.mjs",
    "test": "tsc -p tsconfig.test.json && node .test-build/tests/app.test.js",
    "test:rules": "firebase emulators:exec --project demo-black-archive --only auth,firestore 'node --test tests/firestore.test.mjs'",
    "test:browser": "node --test tests/handout.browser.mjs"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "^14.20.0",
    "globals": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12"
  }
}
