rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(cellId) {
      return /databases/$(database)/documents/cells/$(cellId)/members/$(request.auth.uid);
    }

    function hasRole(cellId, roles) {
      return request.auth != null && get(memberPath(cellId)).data.role in roles;
    }

    function isHandler(cellId) {
      return hasRole(cellId, ['handler']);
    }

    function isAgent(cellId) {
      return hasRole(cellId, ['agent']);
    }

    function validRecord(collectionId) {
      let data = request.resource.data;
      let fields = ['title', 'category', 'summary', 'body', 'tags', 'connections', 'photo',
        'status', 'audience', 'recipientUid', 'stage', 'publishedAt', 'publishedBy', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category is string && data.category.size() <= 60
        && data.summary is string && data.summary.size() <= 500
        && data.body is string && data.body.size() <= 24000
        && data.tags is string && data.tags.size() <= 160
        && data.connections is string && data.connections.size() <= 3000
        && (collectionId == 'personnel' || data.connections == '')
        && data.photo is string && data.photo.size() <= 180000
        && (data.photo == '' || (collectionId == 'personnel'
          && data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')))
        && data.stage is string && data.stage.size() <= 60
        && (collectionId == 'operations' || data.stage == '')
        && data.status in ['draft', 'review', 'published', 'archived']
        && ((data.audience == 'cell' && data.recipientUid == '')
          || (collectionId == 'messages' && data.audience == 'direct'
            && data.recipientUid is string && data.recipientUid.size() > 0
            && data.recipientUid.size() <= 128))
        && data.updatedAt == request.time;
    }

    function validAudit(creating) {
      let data = request.resource.data;
      return data.status == 'published'
        ? data.publishedAt == request.time && data.publishedBy == request.auth.uid
        : (creating
          ? data.publishedAt == null && data.publishedBy == ''
          : data.publishedAt == resource.data.publishedAt
            && data.publishedBy == resource.data.publishedBy);
    }

    match /cells/{cellId} {
      allow get: if hasRole(cellId, ['handler', 'agent']);

      match /members/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
      }

      match /handlerNotes/{noteId} {
        allow read, write: if isHandler(cellId);
      }

      match /handouts/{handoutId} {
        function handoutPath() {
          return /databases/$(database)/documents/cells/$(cellId)/handouts/$(handoutId);
        }

        function visibleTarget(kind, id) {
          let data = get(/databases/$(database)/documents/cells/$(cellId)/$(kind)/$(id)).data;
          return data.status == 'published' && (kind == 'handouts' || data.audience == 'cell');
        }

        function released() {
          return get(handoutPath()).data.status == 'published';
        }

        function validHandout() {
          let data = request.resource.data;
          let fields = ['title', 'category', 'summary', 'narrativeDate', 'tags',
            'classification', 'alt', 'downloadAllowed', 'mime', 'byteLength',
            'status', 'createdAt', 'createdBy', 'publishedAt', 'publishedBy', 'updatedAt'];
          return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
            && data.title is string && data.title.size() > 0 && data.title.size() <= 120
            && data.category is string && data.category.size() <= 60
            && data.summary is string && data.summary.size() <= 1000
            && data.narrativeDate is string && data.narrativeDate.size() <= 80
            && data.tags is string && data.tags.size() <= 160
            && data.classification is string && data.classification.size() > 0 && data.classification.size() <= 48
            && data.alt is string && data.alt.size() > 0 && data.alt.size() <= 240
            && data.downloadAllowed is bool && data.mime in ['image/png', 'image/jpeg', 'image/webp']
            && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 102400
            && data.status in ['draft', 'review', 'published', 'archived']
            && data.updatedAt == request.time;
        }

        function releasable() {
          let operation = get(/databases/$(database)/documents/cells/$(cellId)/handouts/$(handoutId)/relations/operation).data;
          let file = get(/databases/$(database)/documents/cells/$(cellId)/handouts/$(handoutId)/files/preview).data;
          return operation.kind == 'operations' && visibleTarget('operations', operation.targetId)
            && file.bytes is bytes && file.bytes.size() == request.resource.data.byteLength
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'publishedAt', 'publishedBy', 'updatedAt']);
        }

        allow read: if isHandler(cellId) || (isAgent(cellId) && resource.data.status == 'published');
        allow create: if isHandler(cellId) && validHandout() && validAudit(true)
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isHandler(cellId) && validHandout() && validAudit(false)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.mime == resource.data.mime
          && request.resource.data.byteLength == resource.data.byteLength
          && (request.resource.data.status != 'published' || releasable());

        match /files/{fileId} {
          allow get: if fileId == 'preview' && (isHandler(cellId) || (isAgent(cellId) && released()
            && resource.data.keys().hasOnly(['bytes'])));
        }

        match /private/{entryId} {
          allow get: if entryId == 'provenance' && isHandler(cellId);
        }

        match /relations/{slot} {
          function visibleRelation() {
            let kind = resource.data.kind;
            return (slot == 'operation' ? kind == 'operations'
              : slot in ['r1', 'r2', 'r3', 'r4', 'r5', 'r6']
                && kind in ['handouts', 'dossiers', 'personnel', 'clues'])
              && resource.data.keys().hasOnly(['kind', 'targetId'])
              && resource.data.targetId is string && resource.data.targetId.matches('^[A-Za-z0-9_-]{1,128}$')
              && visibleTarget(kind, resource.data.targetId);
          }

          allow get: if isHandler(cellId) || (isAgent(cellId) && released() && visibleRelation());
        }
      }

      match /{collectionId}/{recordId} {
        function supportedCollection() {
          return collectionId in ['operations', 'dossiers', 'personnel', 'clues', 'messages'];
        }

        function agentCanRead() {
          return isAgent(cellId) && resource.data.status == 'published'
            && (resource.data.audience == 'cell'
              || (collectionId == 'messages' && resource.data.audience == 'direct'
                && resource.data.recipientUid == request.auth.uid));
        }

        allow read: if supportedCollection() && (isHandler(cellId) || agentCanRead());
        allow create: if supportedCollection() && isHandler(cellId)
          && validRecord(collectionId) && validAudit(true);
        allow update: if supportedCollection() && isHandler(cellId)
          && validRecord(collectionId) && validAudit(false);
      }
    }
  }
}
